# Copia este archivo a .env y ajusta los valores. El archivo .env NO se sube a Git.

# --- Seguridad ---
# Secreto HS256 compartido por los microservicios (minimo 32 caracteres)
JWT_SECRET=cambia-este-secreto-de-al-menos-32-caracteres
# Clave que usan Lambda -> microservicios en rutas /internal/**
INTERNAL_API_KEY=cambia-esta-clave-interna
# Clave que inyecta API Gateway. Vacia = modo desarrollo (acceso directo permitido)
GATEWAY_KEY=

# --- Base de datos ---
DB_PASSWORD=cambia-esta-password

# --- Usuarios semilla ---
SEED_COMPRADOR_PASSWORD=Comprador123!
SEED_STAFF_PASSWORD=Staff123!

# --- Imagenes (Swarm / CI-CD) ---
REGISTRY=ghcr.io/tu-usuario-en-minusculas
TAG=latest

# --- SQS ---
AWS_REGION=us-east-1
# Local (ElasticMQ) se define en docker-compose.local.yml. En AWS: URL real de la cola
SQS_QUEUE_URL=
